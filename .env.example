# Project NOMAD — variáveis para subir o stack via Docker Compose
#
# === Setup VPS (uma vez) ===
#   curl -fsSL https://get.docker.com | sudo sh
#   sudo usermod -aG docker $USER && newgrp docker
#   sudo mkdir -p /opt/nomad-src && sudo chown $USER:$USER /opt/nomad-src
#   git clone <URL_DO_SEU_REPO> /opt/nomad-src
#   cd /opt/nomad-src && bash install/setup_vps.sh
#
# === Deploys seguintes ===
#   Manual:  cd /opt/nomad-src && git pull && bash install/up_from_source.sh
#   CI/CD:   push em main → .github/workflows/deploy-vps.yml
#            Secrets: VPS_HOST, VPS_USER, VPS_SSH_KEY, VPS_APP_DIR (/opt/nomad-src)
#
# Código: /opt/nomad-src   |   Dados: NOMAD_DATA_DIR abaixo   |   .env NÃO vai pro git

# Onde os DADOS do Nomad ficam no host (ZIMs, MySQL, Redis).
# Pode ser diferente da pasta do código-fonte.
NOMAD_DATA_DIR=/opt/project-nomad

# URL pela qual você acessa o Command Center NA VPS
# Exemplos: http://SEU_IP_PUBLICO:8080  |  http://nomad.seudominio.com:8080
URL=http://localhost:8080

# Porta no host (mapeada para 8080 no container)
HOST_PORT=8080

# Segredos — gere valores aleatórios (o script up_from_source.sh faz isso se estiverem vazios)
# APP_KEY precisa ter pelo menos 16 caracteres
APP_KEY=
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Tag/versão gravada na imagem local (opcional; CI preenche com o SHA do commit)
VERSION=dev

